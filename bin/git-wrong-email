#!/bin/sh
# git-wrong-email -- install, inspect and remove the wrong-email guard.
#
# Named so that with this file on PATH, `git wrong-email <cmd>` works as a git
# subcommand.

set -eu

version=0.2.1

config_home=${XDG_CONFIG_HOME:-$HOME/.config}
root=$config_home/git-wrong-email
hooks_dir=$root/hooks
rules_file=$root/rules

# Every client-side hook name. All of them get a copy, not just the three with
# checks: core.hooksPath makes git ignore .git/hooks wholesale, so a name we do
# not install is a name whose repository-local hook silently stops running.
HOOK_NAMES="
applypatch-msg
pre-applypatch
post-applypatch
pre-commit
pre-merge-commit
prepare-commit-msg
commit-msg
post-commit
pre-rebase
post-checkout
post-merge
pre-push
pre-auto-gc
post-rewrite
sendemail-validate
reference-transaction
push-to-checkout
post-index-change
"

die() {
    echo "git-wrong-email: $*" >&2
    exit 1
}

# Where this script really lives, so it can find the hook and example alongside
# it. Symlinks are followed: Homebrew runs it as $(brew --prefix)/bin/..., a link
# into the Cellar, and the hook is next to the target, not next to the link.
self_dir() {
    f=$0
    while [ -L "$f" ]; do
        link=$(readlink "$f")
        case $link in
        /*) f=$link ;;
        *) f=$(dirname "$f")/$link ;;
        esac
    done
    (cd "$(dirname "$f")" && pwd -P)
}

hook_source() {
    for candidate in "$(self_dir)/../hook/git-wrong-email-hook" \
        "$(self_dir)/git-wrong-email-hook" \
        "$(self_dir)/../libexec/git-wrong-email-hook"; do
        [ -f "$candidate" ] && {
            (cd "$(dirname "$candidate")" && pwd -P)
            return 0
        }
    done
    return 1
}

hook_path() {
    dir=$(hook_source) || die "cannot find git-wrong-email-hook next to $0"
    echo "$dir/git-wrong-email-hook"
}

example_rules() {
    dir=$(self_dir)
    for candidate in "$dir/../examples/rules" "$dir/../share/git-wrong-email/rules"; do
        [ -f "$candidate" ] && {
            echo "$candidate"
            return 0
        }
    done
    return 1
}

current_hooks_path() {
    git config --global --get core.hooksPath 2>/dev/null || true
}

# A dotfiles manager may set core.hooksPath to our directory before `install`
# has put anything in it; that is still ours, not something to chain to.
is_ours() { # path
    [ -n "$1" ] || return 1
    [ "$1" = "$hooks_dir" ] && return 0
    [ -f "$1/pre-commit" ] &&
        grep -q '^# git-wrong-email' "$1/pre-commit" 2>/dev/null
}

cmd_install() {
    source=$(hook_path)
    mkdir -p "$hooks_dir"

    existing=$(current_hooks_path)
    if [ -n "$existing" ] && ! is_ours "$existing"; then
        # Somebody else owns core.hooksPath (husky, lefthook, a dotfiles repo).
        # Chain to it instead of replacing it silently.
        git config --global wrongEmail.chainTo "$existing"
        echo "note: core.hooksPath was $existing"
        echo "      recorded as wrongEmail.chainTo; those hooks still run after the check."
    fi

    for name in $HOOK_NAMES; do
        cp "$source" "$hooks_dir/$name"
        chmod 755 "$hooks_dir/$name"
    done
    git config --global core.hooksPath "$hooks_dir"

    if [ -f "$rules_file" ]; then
        echo "rules: $rules_file (kept)"
    else
        if sample=$(example_rules); then
            cp "$sample" "$rules_file"
        else
            cat > "$rules_file" <<'SAMPLE'
# One rule per line:  <directory>  <email> [<email> ...]
# First matching directory wins, so put specific rules first and "*" last.
*  change-me@example.com
SAMPLE
        fi
        echo "rules: $rules_file (created from the example -- EDIT IT NOW)"
    fi

    echo "installed $(printf '%s' "$HOOK_NAMES" | grep -c .) hooks in $hooks_dir"
    echo "core.hooksPath -> $hooks_dir"
}

cmd_uninstall() {
    existing=$(current_hooks_path)
    if is_ours "$existing"; then
        chain=$(git config --global --get wrongEmail.chainTo 2>/dev/null || true)
        if [ -n "$chain" ]; then
            git config --global core.hooksPath "$chain"
            echo "core.hooksPath restored to $chain"
        else
            git config --global --unset core.hooksPath
            echo "core.hooksPath unset"
        fi
        git config --global --unset wrongEmail.chainTo 2>/dev/null || true
    else
        echo "core.hooksPath is not ours (${existing:-unset}); left alone"
    fi

    for name in $HOOK_NAMES; do
        rm -f "$hooks_dir/$name"
    done
    rmdir "$hooks_dir" 2>/dev/null || true
    echo "hooks removed; $rules_file kept"
}

cmd_status() {
    existing=$(current_hooks_path)
    installed=0
    for name in $HOOK_NAMES; do
        [ -x "$hooks_dir/$name" ] && installed=$((installed + 1))
    done
    total=$(printf '%s' "$HOOK_NAMES" | grep -c .)

    echo "rules file     ${rules_file}$([ -r "$rules_file" ] || echo '  (MISSING)')"
    echo "hooks dir      $hooks_dir"
    echo "hooks present  $installed/$total"
    echo "core.hooksPath ${existing:-<unset>}"
    if is_ours "$existing"; then
        echo "active         yes"
    else
        echo "active         NO -- run: git wrong-email install"
    fi
    chain=$(git config --global --get wrongEmail.chainTo 2>/dev/null || true)
    [ -n "$chain" ] && echo "chain to       $chain"

    # A repository can set its own core.hooksPath (husky does, from npm's
    # prepare script), which beats the global one and switches the check off
    # in that repository without a word.
    if git rev-parse --git-dir >/dev/null 2>&1; then
        effective=$(git config --get core.hooksPath 2>/dev/null || true)
        if [ "$effective" != "$existing" ] && ! is_ours "$effective"; then
            echo "this repo      core.hooksPath is ${effective:-<unset>} -- the check does NOT run here"
            echo "               see: git config --show-origin --show-scope core.hooksPath"
        fi
    fi

    if [ -r "$rules_file" ]; then
        echo
        echo "rules:"
        grep -v '^[[:space:]]*\(#\|$\)' "$rules_file" | sed 's/^/  /'
    fi
    return 0
}

# --- doctor ----------------------------------------------------------------
#
# The rules file is the check and includeIf is the source; nothing else
# compares the two. doctor does: for every directory either of them names it
# works out which email a repository there would commit with and whether the
# rules accept it, then looks at the repositories already cloned there.

tab=$(printf '\t')
probe_name=git-wrong-email-doctor-probe
problems=0

ok() { printf '  ok    %s\n' "$*"; }
fail() {
    printf '  FAIL  %s\n' "$*"
    problems=$((problems + 1))
}
note() { printf '  note  %s\n' "$*"; }
more() { printf '        %s\n' "$*"; }

tilde() {
    # shellcheck disable=SC2088 # printing a literal ~ is the point
    case $1 in
    "$HOME") echo "~" ;;
    "$HOME"/*) echo "~/${1#"$HOME"/}" ;;
    *) echo "$1" ;;
    esac
}

expand_home() {
    case $1 in
    "~") echo "$HOME" ;;
    \~/*) echo "$HOME/${1#\~/}" ;;
    *) echo "$1" ;;
    esac
}

lower() { printf '%s' "$1" | tr '[:upper:]' '[:lower:]'; }

# A directory as the hook will see it: `git rev-parse --show-toplevel` gives
# the physical path, so resolve symlinks when the directory exists.
physical() {
    if [ -d "$1" ]; then (cd "$1" && pwd -P); else echo "$1"; fi
}

# The rule that governs a repository whose top level is $1, as "<line> <emails>";
# the same first-match walk as allowed_emails() in the hook.
rule_for() {
    rf_n=0
    while read -r rf_dir rf_emails; do
        rf_n=$((rf_n + 1))
        case $rf_dir in '' | '#'*) continue ;; esac
        if [ "$rf_dir" != "*" ]; then
            rf_d=$(expand_home "$rf_dir")
            case "$1/" in "${rf_d%/}/"*) ;; *) continue ;; esac
        fi
        echo "$rf_n $rf_emails"
        return 0
    done <"$rules_file"
    return 1
}

is_allowed() { # email emails
    for ia in $2; do [ "$ia" = "$1" ] && return 0; done
    return 1
}

# user.email and includeIf entries of the global config, in the order git
# reads them, following plain [include]s. Run from / so the conditional ones
# are listed rather than evaluated against whatever repository we are in.
config_entries() {
    (cd / && git config --global --includes --show-origin \
        --get-regexp '^(user\.email|includeif\..*\.path)$') 2>/dev/null || true
}

# Where an include's path points; a relative one is relative to the file that
# names it, as git does.
include_file() { # value origin
    case $1 in
    \~/*) expand_home "$1" ;;
    /*) echo "$1" ;;
    *) echo "$(dirname "$2")/$1" ;;
    esac
}

# Does an includeIf condition hold for a repository whose .git is $2? Only
# gitdir: and gitdir/i: are evaluated; onbranch: and hasconfig: never hold for
# a repository that does not exist yet. case's * crosses "/", so ** and * are
# both treated as **: looser than git for a lone *, exact for the trailing-slash
# and ~/ forms people actually write.
gitdir_matches() { # condition gitdir origin
    case $1 in
    gitdir:*) gm_pat=${1#gitdir:} gm_fold=0 ;;
    gitdir/i:*) gm_pat=${1#gitdir/i:} gm_fold=1 ;;
    *) return 1 ;;
    esac
    case $gm_pat in
    \~/*) gm_pat=$(expand_home "$gm_pat") ;;
    ./*) gm_pat="$(dirname "$3")/${gm_pat#./}" ;;
    /*) ;;
    *) gm_pat="**/$gm_pat" ;;
    esac
    case $gm_pat in */) gm_pat="$gm_pat**" ;; esac
    gm_pat=$(printf '%s' "$gm_pat" | sed 's/\*\*/*/g')
    gm_path=$2
    if [ "$gm_fold" = 1 ]; then
        gm_pat=$(lower "$gm_pat")
        gm_path=$(lower "$gm_path")
    fi
    # shellcheck disable=SC2254 # the pattern is meant to glob
    case $gm_path in $gm_pat) return 0 ;; esac
    return 1
}

# The email git would give a new repository whose .git is $1 (and $2, its
# physical spelling; git tries both), as "<email>\t<file>\t<global|include>".
effective_email() {
    ee_email="" ee_from="" ee_via=""
    while IFS= read -r ee_line; do
        [ -n "$ee_line" ] || continue
        ee_origin=${ee_line%%"$tab"*}
        ee_origin=${ee_origin#file:}
        ee_rest=${ee_line#*"$tab"}
        ee_key=${ee_rest%% *}
        ee_val=${ee_rest#* }
        case $ee_key in
        user.email)
            ee_email=$ee_val ee_from=$ee_origin ee_via=global
            ;;
        includeif.*.path)
            ee_cond=${ee_key#includeif.}
            ee_cond=${ee_cond%.path}
            gitdir_matches "$ee_cond" "$1" "$ee_origin" ||
                gitdir_matches "$ee_cond" "$2" "$ee_origin" || continue
            ee_file=$(include_file "$ee_val" "$ee_origin")
            ee_inc=$(git config --file "$ee_file" --get user.email 2>/dev/null) || continue
            ee_email=$ee_inc ee_from=$ee_file ee_via=include
            ;;
        esac
    done <<EOF
$(config_entries)
EOF
    printf '%s\t%s\t%s\n' "$ee_email" "$ee_from" "$ee_via"
}

doctor_install() {
    echo "install"
    di_existing=$(current_hooks_path)
    if is_ours "$di_existing"; then
        ok "core.hooksPath -> $(tilde "$di_existing")"
    else
        fail "core.hooksPath is ${di_existing:-<unset>}, so nothing is checked"
        more "fix: git wrong-email install"
    fi
}

doctor_rules() {
    echo
    echo "rules  $(tilde "$rules_file")"
    dr_before=$problems dr_n=0 dr_count=0 dr_star=0 dr_seen=""
    while read -r dr_dir dr_emails; do
        dr_n=$((dr_n + 1))
        case $dr_dir in '' | '#'*) continue ;; esac
        dr_count=$((dr_count + 1))
        [ -n "$dr_emails" ] ||
            fail "line $dr_n: $dr_dir lists no email, so every repository under it is refused"
        if [ "$dr_star" = 1 ]; then
            fail "line $dr_n: $dr_dir comes after \"*\", so it can never match"
            more "fix: move it above the \"*\" line -- the first matching rule wins"
            continue
        fi
        if [ "$dr_dir" = "*" ]; then
            dr_star=1
            continue
        fi
        dr_d=$(expand_home "$dr_dir")
        dr_d=${dr_d%/}
        while read -r dr_sn dr_sd; do
            [ -n "$dr_sn" ] || continue
            case "$dr_d/" in "$dr_sd/"*)
                fail "line $dr_n: $dr_dir is inside $(tilde "$dr_sd") from line $dr_sn, so it can never match"
                more "fix: move it above line $dr_sn -- the first matching rule wins"
                ;;
            esac
        done <<EOF
$dr_seen
EOF
        [ -d "$dr_d" ] || note "line $dr_n: $dr_dir does not exist (yet)"
        dr_seen="$dr_seen$dr_n $dr_d
"
    done <"$rules_file"

    if [ "$dr_count" = 0 ]; then
        fail "no rules, so every repository is refused"
    elif [ "$dr_star" = 0 ]; then
        note "no \"*\" rule: a repository outside these directories is refused"
    fi
    [ "$problems" = "$dr_before" ] && ok "$dr_count rules, in an order where each one can match"
    return 0
}

# Every directory a rule or a gitdir includeIf names, one per line; "*" last.
doctor_targets() {
    dt_list=""
    # Rules after "*" can never match; doctor_rules has said so already.
    while read -r dt_dir _; do
        case $dt_dir in '' | '#'*) continue ;; '*') break ;; esac
        dt_d=$(expand_home "$dt_dir")
        dt_list="$dt_list${dt_d%/}
"
    done <"$rules_file"
    while IFS= read -r dt_line; do
        dt_key=${dt_line#*"$tab"}
        dt_key=${dt_key%% *}
        case $dt_key in includeif.gitdir:*/.path | includeif.gitdir/i:*/.path) ;; *) continue ;; esac
        dt_pat=${dt_key#includeif.gitdir*:}
        dt_pat=${dt_pat%/.path}
        case $dt_pat in *[*?[]*) continue ;; \~/* | /*) ;; *) continue ;; esac
        dt_d=$(expand_home "$dt_pat")
        printf '%s' "$dt_list" | grep -Fqx -- "$dt_d" || dt_list="$dt_list$dt_d
"
    done <<EOF
$(config_entries)
EOF
    printf '%s' "$dt_list"
    echo "*"
}

doctor_identity() { # directory, or "*"
    if [ "$1" = "*" ]; then
        di_label='* (anywhere else)' di_log="/$probe_name" di_phys="/$probe_name"
    else
        di_label="$(tilde "$1")/"
        di_log="$1/$probe_name"
        di_phys="$(physical "$1")/$probe_name"
    fi

    if ! di_rule=$(rule_for "$di_phys"); then
        fail "$di_label  no rule covers it, so a repository there is refused"
        more "fix: add a line for it above \"*\" in $(tilde "$rules_file")"
        return 0
    fi
    di_label=$(printf '%-20s' "$di_label")
    di_line=${di_rule%% *}
    di_allowed=${di_rule#* }

    di_eff=$(effective_email "$di_log/.git" "$di_phys/.git")
    di_email=${di_eff%%"$tab"*}
    di_rest=${di_eff#*"$tab"}
    di_from=${di_rest%%"$tab"*}
    di_via=${di_rest#*"$tab"}
    di_want=${di_allowed%% *}

    if [ -n "$di_email" ] && is_allowed "$di_email" "$di_allowed"; then
        ok "$di_label  $di_email  (from $(tilde "$di_from"))"
        return 0
    fi

    if [ -z "$di_email" ]; then
        fail "$di_label  no user.email is set, so git cannot commit there"
    else
        fail "$di_label  a repository here would commit as $di_email (from $(tilde "$di_from")),"
        more "but line $di_line of the rules allows only: $di_allowed"
    fi
    if [ "$1" = "*" ]; then
        more "fix: git config --global user.email $di_want"
    elif [ "$di_via" = include ]; then
        more "fix: git config --file $(tilde "$di_from") user.email $di_want"
    else
        di_name=$(basename "$1" | tr -c 'A-Za-z0-9._\n-' '-')
        more "fix: git config --file ~/.gitconfig-$di_name user.email $di_want"
        more "     git config --global includeIf.\"gitdir:$(tilde "$1")/\".path ~/.gitconfig-$di_name"
    fi
    return 0
}

doctor_identities() {
    echo
    echo "identity a new repository would get"
    while IFS= read -r dis_line; do
        dis_key=${dis_line#*"$tab"}
        dis_val=${dis_key#* }
        dis_key=${dis_key%% *}
        dis_origin=${dis_line%%"$tab"*}
        dis_origin=${dis_origin#file:}
        case $dis_key in includeif.gitdir:*.path | includeif.gitdir/i:*.path) ;; *) continue ;; esac
        dis_pat=${dis_key#includeif.}
        dis_pat=${dis_pat%.path}
        dis_file=$(include_file "$dis_val" "$dis_origin")
        [ -r "$dis_file" ] ||
            fail "includeIf \"$dis_pat\" points at $(tilde "$dis_file"), which does not exist"
        case $dis_pat in
        */ | *'*'* | *.git) ;;
        *)
            fail "includeIf \"$dis_pat\" has no trailing slash, so it matches no repository inside that directory"
            more "fix: git config --global --rename-section 'includeIf.$dis_pat' 'includeIf.$dis_pat/'"
            ;;
        esac
    done <<EOF
$(config_entries)
EOF
    while IFS= read -r dis_dir; do
        [ -n "$dis_dir" ] && doctor_identity "$dis_dir"
    done <<EOF
$(doctor_targets)
EOF
}

# What `git config user.email` really says in repositories that already exist
# directly inside a rule's directory -- including a per-repository user.email
# and an includeIf pattern that does not mean what it looks like.
doctor_repositories() {
    echo
    echo "repositories already in those directories"
    dp_checked=0 dp_before=$problems dp_seen=""
    while read -r dp_dir _; do
        case $dp_dir in '' | '#'* | '*') continue ;; esac
        dp_d=$(expand_home "$dp_dir")
        dp_d=${dp_d%/}
        for dp_git in "$dp_d/.git" "$dp_d"/*/.git; do
            [ -e "$dp_git" ] || continue
            dp_top=$(physical "$(dirname "$dp_git")")
            printf '%s' "$dp_seen" | grep -Fqx -- "$dp_top" && continue
            dp_seen="$dp_seen$dp_top
"
            dp_checked=$((dp_checked + 1))
            dp_label=$(tilde "$dp_top")

            dp_hooks=$(git -C "$dp_top" config --get core.hooksPath 2>/dev/null || true)
            if ! is_ours "$dp_hooks"; then
                fail "$dp_label  core.hooksPath is ${dp_hooks:-<unset>}, so the check does not run there"
                more "see: git -C $dp_label config --show-origin --show-scope core.hooksPath"
            fi

            dp_rule=$(rule_for "$dp_top") || continue
            dp_allowed=${dp_rule#* }
            dp_email=$(git -C "$dp_top" config --get user.email 2>/dev/null || true)
            if [ -z "$dp_email" ]; then
                fail "$dp_label  no user.email, so git cannot commit there"
            elif ! is_allowed "$dp_email" "$dp_allowed"; then
                fail "$dp_label  commits as $dp_email; the rules allow only: $dp_allowed"
                more "see: git -C $dp_label config --show-origin user.email"
            fi
            doctor_tags "$dp_top" "$dp_label" "$dp_allowed"
        done
    done <"$rules_file"

    if [ "$dp_checked" = 0 ]; then
        note "none yet"
    elif [ "$problems" = "$dp_before" ]; then
        ok "$dp_checked checked"
    fi
}

# Annotated tags whose tagger the rules would not accept. Only a note: pre-push
# refuses such a tag before it leaves, and one that has already been pushed is
# public, so there is nothing to fix in the configuration -- but it is worth
# knowing about, and an unpushed one can still be remade.
doctor_tags() { # top label allowed
    dg_extra=$(git -C "$1" config --get-all wrongEmail.allowedAuthor 2>/dev/null || true)
    dg_bad=""
    while read -r dg_type dg_name dg_email; do
        [ "$dg_type" = tag ] || continue
        dg_email=${dg_email#<}
        dg_email=${dg_email%>}
        [ -n "$dg_email" ] || continue
        is_allowed "$dg_email" "$3" && continue
        is_allowed "$dg_email" "$dg_extra" && continue
        dg_bad="$dg_bad $dg_name ($dg_email)"
    done <<EOF
$(git -C "$1" for-each-ref refs/tags \
        --format='%(objecttype) %(refname:short) %(taggeremail)' 2>/dev/null)
EOF
    [ -n "$dg_bad" ] || return 0
    note "$2  tags whose tagger the rules would not accept:$dg_bad"
    more "pushing one is refused; if one is already public, it stays as it is"
    more "remake an unpushed one: git tag -d <tag> && git tag -a <tag> <commit>"
}

doctor_environment() {
    echo
    echo "environment"
    de_any=0
    for de_var in GIT_AUTHOR_EMAIL GIT_COMMITTER_EMAIL EMAIL; do
        eval "de_val=\${$de_var:-}"
        if [ -n "$de_val" ]; then
            de_any=1
            note "$de_var=$de_val is set in this shell and overrides the config above"
        fi
    done
    if [ "$(git config --global --get user.useConfigOnly 2>/dev/null)" != true ]; then
        de_any=1
        note "user.useConfigOnly is not set, so git may guess an email as user@hostname"
        more "fix: git config --global user.useConfigOnly true"
    fi
    [ "$de_any" = 1 ] || ok "no overrides"
}

cmd_doctor() {
    doctor_install
    if [ ! -r "$rules_file" ]; then
        echo
        echo "rules  $(tilde "$rules_file")"
        fail "missing"
        more "fix: git wrong-email install"
    else
        doctor_rules
        doctor_identities
        doctor_repositories
    fi
    doctor_environment

    echo
    if [ "$problems" = 0 ]; then
        echo "no problems found"
        return 0
    fi
    echo "$problems problem(s) found"
    return 1
}

cmd_help() {
    cat <<'USAGE'
git-wrong-email -- refuse commits and pushes made under the wrong email.

usage: git wrong-email <command>

  install     copy the hook under every client-side hook name and point
              core.hooksPath at it; create a rules file if there is none
  uninstall   remove the hooks and restore core.hooksPath; keeps the rules
  status      where everything is, whether it is active, and the rules in force
  doctor      cross-check the rules against your includeIf blocks and the
              repositories already cloned; exits 1 if anything is off
  version     print the version
  help        this

rules file: ~/.config/git-wrong-email/rules
  <directory>  <email> [<email> ...]      first match wins, "*" goes last

per-repository escape for a collaborator's commits you carry:
  git config --add wrongEmail.allowedAuthor someone@example.com

deliberate bypass:
  git commit --no-verify / git push --no-verify
USAGE
}

case ${1:-help} in
install) cmd_install ;;
uninstall) cmd_uninstall ;;
status) cmd_status ;;
doctor) cmd_doctor ;;
version | -V | --version) echo "git-wrong-email $version" ;;
help | -h | --help) cmd_help ;;
*) die "unknown command '$1'; try: git wrong-email help" ;;
esac
